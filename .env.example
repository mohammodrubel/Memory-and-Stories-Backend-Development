# Database (Postgres — Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Server
PORT=9000
NODE_ENV=development

# JWT
JWT_ACCESS_TOKEN_SECRET="change-me-access"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_SECRET="change-me-refresh"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (optional)
STRIPE_SECRET_KEY=""

# AI (optional)
API_URL="https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_API_KEY=""

# App base URL (used in customer email links)
APP_BASE_URL="http://localhost:3000"

# Google Drive integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9000/api/integrations/google/callback"
GOOGLE_API_KEY=""
GOOGLE_APP_ID=""

# AES-256 key for encrypting refresh tokens at rest (32 bytes hex = 64 chars)
TOKEN_ENC_KEY=""

# License gate (set LICENSE_ENABLED=false to bypass in local dev)
# Allowed domains live in Supabase only — the app checks incoming request Host
# header against the list returned by verify_license. Buyer cannot fake this.
LICENSE_ENABLED=true
LICENSE_URL=https://YOUR-PROJECT.supabase.co
LICENSE_ANON_KEY=your-supabase-anon-key
LICENSE_KEY=customer-license-key
